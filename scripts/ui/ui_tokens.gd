## true con el tema de alto contraste (la opción del juego); DsTheme.build() la lee.
static var high_contrast := false


## Color de un token por su nombre: UiTokens.color(&"text-accent").
static func color(token: StringName) -> Color:
	if high_contrast and ALTO_CONTRASTE.has(token):
		return ALTO_CONTRASTE[token]
	return JUEGO[token]


## Size in px of a type style ("body" -> 24).
static func type_size(style: StringName) -> int:
	return TYPE[style][0]
